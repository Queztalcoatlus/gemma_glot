# GemmaGlot environment template
#
# Copy this file to .env for local development.
# Do not commit real API keys, tokens, database passwords, or service URLs.


# -----------------------------------------------------------------------------
# App mode
# -----------------------------------------------------------------------------

# Provider used for Gemma analysis.
# Options:
#   google - use Google GenAI API for text analysis. Audio automatically uses
#            Google Cloud Speech-to-Text first, then analyzes the transcript.
#   vllm   - use a vLLM OpenAI-compatible server. This supports local vLLM or
#            a deployed Cloud Run vLLM service.
PROVIDER=google

# Model ID sent to the selected provider.
# Google examples:
#   gemma-4-31b-it
#   gemma-4-26b-a4b-it
# vLLM examples:
#   google/gemma-4-E4B-it
#   google/gemma-4-E2B-it
MODEL=gemma-4-31b-it


# -----------------------------------------------------------------------------
# Google GenAI API auth
# Used when PROVIDER=google, both locally and in deployment
# -----------------------------------------------------------------------------

# Google GenAI/Gemini API key. Required for real Google API responses.
# If omitted locally, the app returns deterministic mock analysis.
GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# Google Speech-to-Text cloud resource
# Used automatically for audio analysis when PROVIDER=google and GOOGLE_API_KEY
# is set.
# -----------------------------------------------------------------------------

# Google Cloud project ID, not project display name.
# Example: gemmaglot-demo-123456
GOOGLE_CLOUD_PROJECT=

# Speech-to-Text v2 location.
# Common options:
#   us     - United States multi-region; default for this app
#   eu     - European Union multi-region
#   global - global endpoint/resource
GOOGLE_CLOUD_LOCATION=us

# Speech recognition language code.
# Useful Spanish options:
#   es-US - Spanish, United States
#   es-ES - Spanish, Spain
#   es-MX - Spanish, Mexico
#   es-419 - Spanish, Latin America and Caribbean
SPEECH_LANGUAGE_CODE=es-US

# Speech-to-Text model.
# Common options:
#   chirp_3   - latest multilingual ASR model, good default
#   chirp_2   - previous-generation universal speech model
#   telephony - phone-call audio, typically 8 kHz
SPEECH_MODEL=chirp_3


# -----------------------------------------------------------------------------
# vLLM mode: local or Cloud Run
# Used when PROVIDER=vllm
# -----------------------------------------------------------------------------

# Base URL for the OpenAI-compatible vLLM API.
# Local vLLM example:
#   http://localhost:8001/v1
# Cloud Run vLLM example:
#   https://YOUR-VLLM-SERVICE-URL.a.run.app/v1
VLLM_BASE_URL=http://localhost:8001/v1

# Optional bearer token for vLLM.
# Required if vLLM is started with --api-key.
VLLM_API_KEY=

# Request timeout in seconds. Cloud Run GPU cold starts can be slow.
# Local vLLM example: 300
# Cloud Run vLLM example: 600
VLLM_TIMEOUT_SECONDS=300


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# If omitted, the app uses local SQLite at .data/gemma_glot.db.
# MySQL example:
#   mysql+pymysql://gemma_glot:your_password_here@localhost:3306/gemma_glot
DATABASE_URL=
